GROQ_API_KEY=

# Provider-agnostic LLM config (overrides GROQ_API_KEY-only setup below).
# LLM_BASE_URL: OpenAI-compatible base URL for the chat-completions endpoint.
#   Groq default:    https://api.groq.com/openai/v1
#   Baseten example: https://inference.baseten.co/v1
# LLM_API_KEY: API key for the endpoint above. Falls back to GROQ_API_KEY if unset.
# LLM_MODEL: model name as served by the chosen endpoint (defaults to openai/gpt-oss-120b).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
